    "eslint-plugin-no-unsanitized": "^4.1.5",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3"
