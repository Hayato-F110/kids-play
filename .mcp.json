{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "msedge",
        "--headless",
        "--isolated",
        "--allowed-origins",
        "http://localhost:8000",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
