{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "msedge",
        "--headless",
        "--isolated",
        "--allowed-origins",
        "http://localhost:8000",
        "--output-dir",
        ".playwright-mcp"
      ]
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp"
    },
    "kids-docs": {
      "command": "uv",
      "args": ["run", "--directory", "tools/ai", "--frozen", "python", "docs_mcp.py"]
    }
  }
}
