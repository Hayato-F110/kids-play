{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-secrets.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-and-lint.mjs"],
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(secrets/**)",
      "Read(data/**)",
      "Read(backend/data/**)",
      "mcp__playwright__browser_run_code_unsafe",
      "PowerShell(adb*content delete*)",
      "PowerShell(adb*content update*)",
      "PowerShell(adb*content insert*)",
      "PowerShell(adb* rm *)",
      "PowerShell(adb* mv *)",
      "PowerShell(adb*-delete*)",
      "PowerShell(adb*-exec*)",
      "PowerShell(adb*pm clear*)",
      "PowerShell(adb*wipe*)",
      "PowerShell(adb*input *)",
      "PowerShell(adb*screencap*)",
      "PowerShell(adb*screenrecord*)",
      "Bash(adb*content delete*)",
      "Bash(adb*content update*)",
      "Bash(adb*content insert*)",
      "Bash(adb* rm *)",
      "Bash(adb* mv *)",
      "Bash(adb*-delete*)",
      "Bash(adb*-exec*)",
      "Bash(adb*pm clear*)",
      "Bash(adb*wipe*)",
      "Bash(adb*input *)",
      "Bash(adb*screencap*)",
      "Bash(adb*screenrecord*)"
    ],
    "ask": [
      "PowerShell(adb shell*)",
      "PowerShell(adb*shell *)",
      "PowerShell(adb push*)",
      "PowerShell(adb uninstall*)",
      "Bash(adb shell*)",
      "Bash(adb*shell *)",
      "Bash(adb push*)",
      "Bash(adb uninstall*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npx:*)",
      "Bash(uv add:*)",
      "Bash(uv sync:*)",
      "Bash(uv pip install:*)",
      "Bash(winget install:*)",
      "Bash(aws:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker compose down:*)",
      "PowerShell(git push)",
      "PowerShell(git push*main*)",
      "PowerShell(git push*--force*)",
      "PowerShell(git push* -f*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(npm install:*)",
      "PowerShell(npm i:*)",
      "PowerShell(npx:*)",
      "PowerShell(uv add:*)",
      "PowerShell(uv sync:*)",
      "PowerShell(uv pip install:*)",
      "PowerShell(winget install:*)",
      "PowerShell(aws:*)",
      "PowerShell(ssh:*)",
      "PowerShell(scp:*)",
      "PowerShell(docker rm:*)",
      "PowerShell(docker rmi:*)",
      "PowerShell(docker system prune:*)",
      "PowerShell(docker volume rm:*)",
      "PowerShell(docker compose down:*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(npm test:*)",
      "Bash(npx prettier --check:*)",
      "Bash(npx eslint:*)",
      "Bash(git --version)",
      "Bash(uv --version)",
      "Bash(python --version)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(java -version)",
      "Bash(adb version)",
      "Bash(docker --version)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git stash:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git show:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git push -u origin *)",
      "PowerShell(git push origin *)",
      "PowerShell(node --check:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Select-String:*)",
      "PowerShell(uv run pytest:*)",
      "PowerShell(uv run ruff:*)",
      "PowerShell(npm test:*)",
      "PowerShell(npx prettier --check:*)",
      "PowerShell(npx eslint:*)",
      "PowerShell(git --version)",
      "PowerShell(uv --version)",
      "PowerShell(python --version)",
      "PowerShell(node --version)",
      "PowerShell(npm --version)",
      "PowerShell(java -version)",
      "PowerShell(adb version)",
      "PowerShell(docker --version)"
    ]
  }
}
